# ============================================
# Trove - Multi-Agent Research Assistant
# ============================================

# LLM Configuration
# At least one provider API key is required
DEFAULT_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small

# Search (Tavily - get free key at tavily.com)
TAVILY_API_KEY=

# OAuth - Google (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT Session
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Storage
UPLOAD_DIR=./uploads
SQLITE_DB_PATH=./data/trove.db
CHROMA_DB_PATH=./data/chroma
